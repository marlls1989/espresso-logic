// Boolean expression grammar for lalrpop
// Supports standard boolean operators with proper precedence:
// Parentheses () > NOT (~, !) > AND (*, &) > XOR (^) > OR (+, |)
//
// Each rule builds a reverse-Polish (postfix) `Vec<RpnToken>` bottom-up; the caller wraps the
// top-level program directly into an owned `BoolExpr`. The grammar keeps accepting
// both the `*`/`+`/`~` and the `&`/`|`/`!` spellings, but both lower to the single canonical token set.
//
// `Token` is imported under the alias `RpnToken` to avoid colliding with lalrpop's own internal
// `Token` lexer type in the generated parser.

use crate::expression::rpn::Token as RpnToken;
use crate::Symbol;

grammar;

// Main entry point: the postfix program.
pub Expr: Vec<RpnToken> = {
    <ops:OrExpr> => ops,
};

// OR has lowest precedence (supports both + and |)
OrExpr: Vec<RpnToken> = {
    <mut l:OrExpr> "+" <r:XorExpr> => { l.extend(r); l.push(RpnToken::Or); l },
    <mut l:OrExpr> "|" <r:XorExpr> => { l.extend(r); l.push(RpnToken::Or); l },
    XorExpr,
};

// XOR sits between OR and AND
XorExpr: Vec<RpnToken> = {
    <mut l:XorExpr> "^" <r:AndExpr> => { l.extend(r); l.push(RpnToken::Xor); l },
    AndExpr,
};

// AND has higher precedence (supports both * and &)
AndExpr: Vec<RpnToken> = {
    <mut l:AndExpr> "*" <r:NotExpr> => { l.extend(r); l.push(RpnToken::And); l },
    <mut l:AndExpr> "&" <r:NotExpr> => { l.extend(r); l.push(RpnToken::And); l },
    NotExpr,
};

// NOT has highest precedence
NotExpr: Vec<RpnToken> = {
    "~" <mut e:NotExpr> => { e.push(RpnToken::Not); e },
    "!" <mut e:NotExpr> => { e.push(RpnToken::Not); e },
    Term,
};

// Base terms
Term: Vec<RpnToken> = {
    // Variables (identifiers)
    <v:Ident> => vec![RpnToken::Var(Symbol::from(v))],

    // Constants
    "0" => vec![RpnToken::Const(false)],
    "1" => vec![RpnToken::Const(true)],
    "true" => vec![RpnToken::Const(true)],
    "false" => vec![RpnToken::Const(false)],

    // Parenthesized expressions (still a postfix program — only the top-level `Expr` realises one)
    "(" <e:OrExpr> ")" => e,
};

// Lexer rules

// Match identifiers (variable names)
//
// A name is one or more segments joined by `/` or `.`, so a variable can carry the hierarchical path
// a netlist gives it — `xtop/xcore/net12`, or `xtop.xcore.net12` in the dotted spelling. The first
// segment opens with a letter or underscore, keeping `0`, `1`, `true` and `false` readable as the
// constants they are; later segments may be wholly numeric, as extracted netlists often name an
// instance by number.
//
// Any segment may carry a bus index — `data<3>` or `data[3]` — or a range, `data<7:0>` / `data[7:0]`,
// in either the angle spelling Spectre writes or the bracket spelling Verilog does. A name is one
// variable whatever its shape: `bus[3]` and `bus[4]` are two unrelated variables, not one indexed
// object, and nothing here interprets the index.
//
// The characters admitted — `/`, `.`, `<`, `>`, `[`, `]`, `:` — are exactly those the operator set
// leaves free, so no name can swallow an operator. `!` and `+` stay out even though netlists use them
// (`vdd!`, and `+` in some tools): both are operators here, and a name carrying one would have to be
// quoted to be read back.
//
// Note: Operators must be listed explicitly before identifiers to avoid
// being treated as special regex characters
match {
    // Operators (must come before identifiers)
    "&",
    "|",
    "*",
    "+",
    "^",
    "~",
    "!",
    "(",
    ")",

    // Keywords/constants
    "true",
    "false",
    "0",
    "1",

    // Identifiers (matches variable names, including hierarchical paths and bus indices)
    r"[a-zA-Z_][a-zA-Z0-9_]*(\[[0-9]+(:[0-9]+)?\]|<[0-9]+(:[0-9]+)?>)?([./][a-zA-Z0-9_]+(\[[0-9]+(:[0-9]+)?\]|<[0-9]+(:[0-9]+)?>)?)*" => Ident,

    // Skip whitespace
    r"\s+" => { },
}
